DATABASE_URL=postgresql://postgres:<password>@localhost:5432/studyspot
PORT=4000
JWT_SECRET=generate-a-long-random-string
JWT_EXPIRES_IN=7d
COOKIE_SECURE=false
# COOKIE_DOMAIN=.example.com   # optional; share the cookie across subdomains
FRONTEND_URL=http://localhost:3001
# Optional dev seed password overrides (defaults are admin123 / admin123 / password123)
# SEED_SUPER_ADMIN_PASSWORD=admin123
# SEED_ADMIN_PASSWORD=admin123
# SEED_STUDENT_PASSWORD=password123